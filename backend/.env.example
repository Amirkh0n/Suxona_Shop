# ============================================================
# SuxonaShop BACKEND  —  backend/.env
#   cp backend/.env.example backend/.env
# Frontend o'zgaruvchilari alohida: frontend/.env.example
# ============================================================

# ---------- Django (asosiy) ----------
DJANGO_SETTINGS_MODULE=config.settings.local
# Production'da majburiy va maxfiy (uzun tasodifiy qator). "change-me" bilan production ishga tushmaydi.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# https orqasida admin ishlashi uchun, masalan https://api.example.com (Render'da avtomatik qo'shiladi)
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---------- Frontend bilan aloqa ----------
# Frontend sayt(lar)i, vergul bilan (oxirida "/" yo'q). Production'da MAJBURIY.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Telegram xabarlaridagi havolalar va webhook uchun ochiq manzillar.
# SITE_BASE_URL webhook uchun https:// bo'lishi shart (Telegram talabi).
SITE_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# ---------- Ma'lumotlar bazasi ----------
# Hech narsa berilmasa — SQLite (backend/db.sqlite3).
# Render/Neon va h.k.: DATABASE_URL (POSTGRES_* dan ustun turadi)
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Docker compose'dagi Postgres yoki lokal Postgres uchun:
# POSTGRES_HOST=localhost
POSTGRES_DB=suxonashop
POSTGRES_USER=suxonashop
POSTGRES_PASSWORD=suxonashop
POSTGRES_PORT=5432

# ---------- Telegram bot ----------
TELEGRAM_BOT_USERNAME=SuxonaShopBot
TELEGRAM_BOT_TOKEN=
# Tasodifiy uzun qator (webhook so'rovlarini tasdiqlash uchun)
TELEGRAM_WEBHOOK_SECRET=
# Ixtiyoriy: yangi do'kon arizalari yuboriladigan chat/guruh id
TELEGRAM_ADMIN_CHAT_ID=
# Har ishga tushganda webhook'ni o'rnatish (Docker/Render): true
# SET_TELEGRAM_WEBHOOK=true

# ---------- Rasmlar: Cloudflare R2 (ixtiyoriy lokalda, Render'da majburiy) ----------
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT_URL=
# Rasmlarning ochiq manzili (r2.dev yoki o'z domeningiz); frontend VITE_IMAGE_BASE_URL bilan bir xil
CLOUDFLARE_R2_PUBLIC_URL=
# R2 bo'lmasa lokal diskka yozish:
# DJANGO_MEDIA_ROOT=/data/media
# DJANGO_SERVE_MEDIA=true

# ---------- Xavfsizlik (production) ----------
# Admin panel manzili (maxfiy yo'l qo'ying, bot-skanerlardan yashirish uchun): DJANGO_ADMIN_URL=boshqaruv-x7k2/
# Backend oldida nechta proksi bor (Render = 1; Cloudflare ham oldida bo'lsa 2). IP-limit shunga tayanadi:
# DJANGO_NUM_PROXIES=1
# DJANGO_SECRET_KEY kamida 32 belgi: python -c "import secrets;print(secrets.token_urlsafe(50))"
# http -> https yo'naltirish (faqat http localhost'da false qiling)
# DJANGO_SSL_REDIRECT=true
# HSTS soniyalari (0 = o'chiq; https hamma joyda ishlagach 31536000)
# DJANGO_HSTS_SECONDS=0
# So'rovlar chegarasi (DRF formati)
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_AUTH=10/min

# ---------- Ixtiyoriy ----------
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
# REDIS_URL=redis://localhost:6379/1
# WEB_CONCURRENCY=2
# GUNICORN_TIMEOUT=60
