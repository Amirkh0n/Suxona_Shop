DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production, https admin behind a proxy: e.g. https://api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database. On Render/Neon/etc. set DATABASE_URL (it wins over POSTGRES_*):
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Leave both unset for local SQLite. docker compose uses the POSTGRES_* values below.
POSTGRES_DB=suxonashop
POSTGRES_USER=suxonashop
POSTGRES_PASSWORD=suxonashop
# POSTGRES_HOST=db   (docker compose sets this itself; uncomment to use Postgres outside compose)
POSTGRES_PORT=5432

CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT_URL=

TELEGRAM_BOT_USERNAME=SuxonaShopBot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional: chat/group id that gets a message for every new store application
TELEGRAM_ADMIN_CHAT_ID=

# Public URLs used in Telegram notification links and for the webhook.
# SITE_BASE_URL must be https:// for the webhook (Telegram requirement).
SITE_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# Comma-separated browser origins allowed to call the API (required in production)
DJANGO_CORS_ALLOWED_ORIGINS=
# Public base URL of uploaded media (Cloudflare R2 custom domain / r2.dev URL).
# Set the frontend's VITE_IMAGE_BASE_URL to the same value.
CLOUDFLARE_R2_PUBLIC_URL=
# Optional rate-limit overrides (DRF format, e.g. 10/min)
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_AUTH=10/min

# --- Production extras ---
# Production refuses to start without a real DJANGO_SECRET_KEY and DJANGO_CORS_ALLOWED_ORIGINS.
# Redirect http -> https (turn off only for plain-http localhost): DJANGO_SSL_REDIRECT=true
# HSTS seconds (0 = off; try 31536000 once https works everywhere): DJANGO_HSTS_SECONDS=0
# Where local-disk uploads go, and whether Django serves them (only when R2 is not used):
# DJANGO_MEDIA_ROOT=/data/media
# DJANGO_SERVE_MEDIA=true
# Run `set_telegram_webhook` on every start: SET_TELEGRAM_WEBHOOK=true
# Optional: SENTRY_DSN=  REDIS_URL=  WEB_CONCURRENCY=2
