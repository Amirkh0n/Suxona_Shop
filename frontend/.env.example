# Backend API manzili (oxirida / bo'lmasin)
VITE_API_BASE_URL=http://localhost:8000

# API rasm maydonlari (product.primary_image, store.logo va h.k.) to'liq URL
# emas, faqat yo'l qaytaradi (masalan "/media/products/12.jpg"). Shu sabab
# frontend ularni shu manzilga nisbatan to'ldiradi. Odatda backend bilan bir
# xil bo'ladi, shuning uchun bo'sh qoldirsangiz VITE_API_BASE_URL ishlatiladi.
#
# Kelajakda rasmlar Cloudflare R2 (yoki boshqa CDN/bucket)ga ko'chirilsa,
# shu yerga bucket'ning ochiq (public) manzilini yozish kifoya — kodda
# hech narsani o'zgartirish shart emas:
# VITE_IMAGE_BASE_URL=https://pub-xxxxxxxx.r2.dev
VITE_IMAGE_BASE_URL=
