# ============================================================
# SuxonaShop FRONTEND  —  frontend/.env   (lokal)
#   cp frontend/.env.example frontend/.env
# Cloudflare Pages'da: Settings → Environment variables (build vaqtida o'qiladi,
# o'zgarsa qayta build qiling). Backend o'zgaruvchilari: backend/.env.example
# ============================================================

# Backend API manzili (oxirida "/" bo'lmasin)
# Production: https://suxonashop-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Rasm maydonlari faqat yo'l qaytaradi ("/media/products/12.jpg"); frontend ularni
# shu manzilga nisbatan to'ldiradi. Bo'sh bo'lsa VITE_API_BASE_URL ishlatiladi.
# R2 ishlatilsa: backend'dagi CLOUDFLARE_R2_PUBLIC_URL bilan bir xil qiymat.
# VITE_IMAGE_BASE_URL=https://pub-xxxxxxxx.r2.dev
VITE_IMAGE_BASE_URL=
